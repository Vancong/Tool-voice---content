# Environment variables example for Movie Review Tool
# Copy this file to .env and fill in the values.

# Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenAI API (for ChatGPT Review Writer)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# ElevenLabs API Key (for ElevenLabs High-Quality TTS)
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# Google Sheet Webhook URL (for Auto-syncing analysis & review script)
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_SHEET_ID=""

# CapCut/TikTok TTS Session ID (if using TTS provider)
CAPCUT_SESSION_ID="YOUR_CAPCUT_SESSION_ID"

# Optional: SQLite DB path (absolute or relative)
SQLITE_DB_PATH="data/database/movie_review.db"

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
